# AFTERGLOW configuration. Copy this file to .env and fill it in. Never commit .env.

# Server
PORT=8788
HOST=127.0.0.1
DATABASE_PATH=var/afterglow.db

# Qloo. Request a hackathon key through the form linked in docs/QLOO_INTEGRATION.md.
# The key stays on the server. It is never sent to the browser.
QLOO_API_KEY=
QLOO_API_URL=https://hackathon.api.qloo.com
QLOO_TIMEOUT_MS=15000
# Protective cap on Qloo calls per UTC day. 0 turns the cap off.
QLOO_DAILY_CALL_CAP=2000

# Hosting
# Set to true on the hosted demo so a non loopback HOST is allowed without a token.
AFTERGLOW_PUBLIC_DEMO=false
# Optional bearer token that protects /api when set (16 or more characters).
AFTERGLOW_ACCESS_TOKEN=
# Extra browser origins allowed to make write requests, separated by commas.
AFTERGLOW_ALLOWED_ORIGINS=
AFTERGLOW_RATE_LIMIT_PER_MINUTE=120
AFTERGLOW_TRUST_PROXY=false
AFTERGLOW_CASE_TTL_HOURS=48
SERVE_WEB=true
